# Copy this file to `.env` and fill in your Reddit app's client ID.
#
# How to get one (takes ~2 minutes, free):
#   1. Go to https://www.reddit.com/prefs/apps
#   2. Click "create another app..."
#   3. Choose type: "installed app"
#   4. Name: anything (e.g. "readit")
#   5. redirect uri: http://localhost:5173  (required, but unused by this app)
#   6. Create it. The client ID is the string shown UNDER the app name,
#      just below "installed app".
#
# The client ID for an installed app is not a secret, but we keep it out of
# the committed code anyway. Without it, the app runs in demo-data mode.
REDDIT_CLIENT_ID=

# Reddit asks every app to send a descriptive User-Agent. Optional; a default
# is used if you leave this blank. Format: platform:appname:version (by /u/you)
REDDIT_USER_AGENT=web:readit:v1.0 (by /u/your_username)
